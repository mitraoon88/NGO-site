# ── Copy this to .env.local and fill in. Never commit .env.local. ─────────────

# The WordPress REST namespace. Leave blank to run on the bundled mock content
# (apps/web/content/home.ts) — the page builds and renders with no backend.
WP_API_URL=https://wp.a2foundation.in/wp-json/a2/v1

# Public site origin, used for canonical URLs and OG metadata.
NEXT_PUBLIC_SITE_URL=https://a2foundation.in

# Shared secret for on-demand ISR. MUST equal A2_REVALIDATE_SECRET in the
# WordPress wp-config.php. Generate with: openssl rand -hex 32
# A mismatch fails silently by design — the publish simply does not revalidate.
A2_REVALIDATE_SECRET=
